    ],
    "forklaring": {
      "steg": [
        "128 + 64 = 192."
      ]
    }
  },
  {
    "id": "21-010",
    "nivå": 2,
    "type": "tall",
    "spørsmål": "Hvor mange vertsbit har et /20-nett?",
    "svar": [
      "12"
    ],
    "forklaring": {
      "steg": [
        "Vertsbit = 32 − prefiks = 32 − 20 = 12."
      ]
    }
  },

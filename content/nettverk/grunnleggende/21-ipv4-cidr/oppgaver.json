      ]
    }
  },
  {
    "id": "21-006",
    "nivå": 2,
    "type": "tall",
    "spørsmål": "Hvilken prefikslengde har nettmasken 255.255.255.224?",
    "svar": [
      "27"
    ],
    "forklaring": {
      "steg": [
        "224 = `11100000` gir 3 enere.",
        "24 + 3 = /27."
      ]
    }
  },
  {
    "id": "21-007",
    "nivå": 2,

      "127.0.0.0/8",
      "192.168.0.0/16",
      "100.64.0.0/10"
    ],
    "svar": [
      "169.254.0.0/16"
    ],
    "forklaring": {
      "steg": [
        "169.254.0.0/16 er link-local (RFC 3927).",
        "En slik adresse er et tydelig tegn på at DHCP ikke virket."
      ]
    }
  },

  {
    "id": "22-026",
    "nivå": 2,
    "type": "tall",
    "spørsmål": "Du trenger plass til 50 verter i ett subnett. Hvilket prefiks gir det minste nettet som er stort nok?",
    "svar": [
      "26"
    ],
    "forklaring": {
      "steg": [
        "Finn minste $h$ der $2^h - 2 \\ge 50$: $2^{6} - 2 = 62$.",
        "$2^{5} - 2 = 30$ er for lite.",
        "Prefiks = 32 − 6 = /26."
      ]
    }
  },

  {
    "id": "22-018",
    "nivå": 2,
    "type": "tall",
    "spørsmål": "Hvor mange brukbare vertsadresser har et /27-nett?",
    "svar": [
      "30"
    ],
    "forklaring": {
      "steg": [
        "Vertsbit: 32 − 27 = 5.",
        "$2^{5} - 2 = 32 - 2 = 30$ (nettadresse og broadcast trekkes fra)."
      ]
    }
  },
